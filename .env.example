# Copiez ce fichier en `.env` et renseignez votre clé.
# Le `.env` est ignoré par git (voir .gitignore).

ANTHROPIC_API_KEY=

# Modèle utilisé pour la génération. On peut basculer selon le besoin :
#   - claude-haiku-4-5-20251001  -> rapide et économique, idéal pour itérer
#   - claude-sonnet-4-6          -> meilleure qualité, pour la version finale
ANTHROPIC_MODEL=claude-sonnet-4-6
